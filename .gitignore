# Dependencies
#
# Lockfiles are tracked: a clean install has to resolve to the versions that were tested, which is
# what CI's `bun install --frozen-lockfile` and the container build check. Only the lockfiles of
# other package managers are ignored, so a stray `npm install` cannot look authoritative.
node_modules/
.pnpm-store/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Build outputs
dist/
build/
.out/
*.tsbuildinfo

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDE and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Cache & temporary files
.turbo/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/

# Uploads & generated binaries
uploads/
storage/
export_cache/

# Evaluation reports describe real held-out material and are regenerated on demand.
# The harness, its fixtures and its format documentation are tracked; its outputs are not.
evaluations/reports/*.json

# Local API database (SQLite file and its write-ahead log)
data/
*.sqlite
*.sqlite-*

# Local backups, whatever the script was pointed at.
backups/
