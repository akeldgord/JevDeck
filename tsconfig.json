  "references": [
    { "path": "./packages/contracts" },
    { "path": "./packages/scheduling" },
    { "path": "./packages/validation" },
    { "path": "./packages/generation" },
    { "path": "./packages/providers" },
    { "path": "./packages/anki_export" },
    { "path": "./packages/evaluation" },
    { "path": "./apps/web" },
    { "path": "./apps/api" },
    { "path": "./apps/worker" }
  ]
}
