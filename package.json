{
  "name": "jevdeck",
  "version": "0.1.0",
  "description": "Turn your documents into flashcards worth remembering",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter \"@jevdeck/web\" dev",
    "dev:api": "bun --filter \"@jevdeck/api\" start",
    "serve": "bun run build && bun --filter \"@jevdeck/api\" start",
    "build": "bun --filter \"@jevdeck/web\" build",
    "preview": "bun --filter \"@jevdeck/web\" preview",
    "test": "bun test",
    "typecheck": "tsc -b",
    "backup": "bun scripts/backup.ts",
    "restore": "bun scripts/restore.ts",
    "evaluate": "bun scripts/evaluate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.5.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.2"
  }
}
